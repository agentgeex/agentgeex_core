# Win3 BFF — 环境与端口配置示例
# 复制为 .env 并按需修改；加载点 app/config.py（真实环境变量优先级更高）

# 服务端口
BFF_HOST=0.0.0.0
BFF_PORT=8090

# 跨域来源（前端 dev / preview）
BFF_CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190,http://localhost:4190

# AgentGeeX 配置（复用内核 agx_config.json 时留空，走默认查找）
# AGX_CONFIG_PATH=~/repos/agentgeex/agx_config.json

# ── JWT ────────────────────────────────────────────
# BFF_JWT_EXPIRE_MINUTES：登录有效期（分钟）。43200 = 30 天（默认）。
# 改完必须 ./start.sh restart 才生效。
BFF_JWT_EXPIRE_MINUTES=43200
# JWT 密钥（生产必须替换为强随机值）
BFF_JWT_SECRET=change-me-in-production
BFF_JWT_ALG=HS256

# 日志级别
BFF_LOG_LEVEL=INFO

# ── 语音转文字（ASR）────────────────────────────────
# 本机语音服务（reasoning_service/audio/audio_service_server.py）的 WS 基址。
# 前端只认 /v1/audio/transcribe，这个地址只存在于服务端：
# 换机器/换端口只改这里，不用重新打包前端。
# ── 多台语音识别主机（2026-11-07）────────────────────────────────
# 本地算力有限，语音服务可以部署在多台服务器上，人在这里选"用哪一台"。
#
# ★ 分工（别混）：
#     本文件（BFF_ASR_HOSTS） = 部署事实：**有哪些可选**（改完要 ./start.sh restart）
#     设置界面里选的          = 运行偏好：**这次用哪台**（立刻生效，存
#                               webtools/server/.runtime/service_settings.json，重启保留）
#   所以换机器/加机器只改这里，不需要重新打包前端，也不需要重新选一遍。
#
# 格式：JSON 数组，每项 {id, name, url, note}
#   id   唯一标识（前端靠它记"选了哪台"）。改了 id 等于换了一台，之前的选中会失效回到第一台。
#   url  WS 基址，**到 audio2text 结尾**，具体识别由 BFF 每次拼 client_id
#   note 给人看的一句话（机器型号/位置/算力），不参与任何逻辑
#
# 配了 BFF_ASR_HOSTS 就取代下面的 BFF_ASR_WS_URL（后者只在没配清单时兜底）。
# 配错（坏 JSON / 缺 url / id 重复）不会让 BFF 起不来 —— 退回单机默认并记 warning。
# BFF_ASR_HOSTS=[{"id":"local","name":"本机","url":"ws://127.0.0.1:8888/ws/audio/audio2text","note":"Mac · MPS"},{"id":"gpu01","name":"GPU 服务器","url":"ws://10.0.0.21:8888/ws/audio/audio2text","note":"局域网 · 独立显卡"}]
BFF_ASR_HOSTS=

# 单机兜底（只在 BFF_ASR_HOSTS 为空时用）
BFF_ASR_WS_URL=ws://127.0.0.1:8888/ws/audio/audio2text
# 单次识别超时（秒）。热态 0.9s、冷态（模型首载）约 10s → 30s 两头都容得下。
BFF_ASR_TIMEOUT=30
# 后台探活间隔（秒）。服务是短连接、没有"长连接可重连"，
# 靠这个定期探活来发现"它回来了"，界面自动恢复可用。
BFF_ASR_HEALTH_INTERVAL=8
