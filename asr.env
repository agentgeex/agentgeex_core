# ============================================================
# ASR 服务配置（asr_service.sh 启动时 source 本文件）
#
# 为什么这个文件进库：模型路径原来只藏在代码里当默认值，看代码才知道
# 用的是哪个模型、放在哪。显式写出来，换人接手不用猜。
#
# ★ 这里写的是【默认值】，不是强制值：用 ${VAR:=...} 赋值语义是
#   「没设过才设」。所以外面显式传的优先级更高：
#       ASR_PORT=8890 ./asr_service.sh start    ← 这次用 8890
#       VOICE_MODEL=/tmp/x ./asr_service.sh start  ← 临时换模型
#   反过来的写法（ASR_PORT=8888）会让文件里的值盖掉命令行，排查时很坑。
#
# 路径统一用 $HOME —— shell 在 source 时展开成本机家目录，
# 所以不写死任何人的用户名，clone 下来直接可用。
# ============================================================

# ---- 监听 ----
# 只绑回环。这些接口没有鉴权，绑 0.0.0.0 等于同网段任何人都能白嫖本机算力。
: "${ASR_HOST:=127.0.0.1}"
: "${ASR_PORT:=8888}"

# ---- 模型 ----
# 两个模型可以不用事先下载：目录不存在时代码会回落 model id，由 funasr
# 自己下（首次约 900MB，日志有明确提示），之后再走本地缓存。
#
# 注意 modelscope 有两套缓存布局，代码两种都认（见 tools/audio_stt/_models.py）：
#   旧: <root>/hub/models/iic/SenseVoiceSmall          ← 下面默认值走这个
#   新: <root>/models/iic--SenseVoiceSmall/snapshots/master
# 所以在新版 modelscope（如 1.40）的机器上，这两个路径不存在也正常 ——
# 代码会用新布局那份缓存，日志打 INFO 说明，不报警告。
: "${VOICE_MODEL:=$HOME/.cache/modelscope/hub/models/iic/SenseVoiceSmall}"
: "${VAD_MODEL:=$HOME/.cache/modelscope/hub/models/iic/speech_fsmn_vad_zh-cn-16k-common-pytorch}"

# ---- 解释器 ----
# 留空 = 自动探测：仓库 .venv（须能 import funasr）→ PATH 上的 python3。
# 想在某个特定环境跑（比如 conda），把下面注释去掉填上绝对路径。
#ASR_PYTHON=/opt/miniconda3/envs/py310_motozolo/bin/python

# ---- 调试 ----
# ASR_DEBUG_AUDIO=1 时每次识别把收到的音频存到 tools/audio_stt/debug_audio/
# （默认 0：不写盘。源项目曾因此积了 178MB / 417 个 wav）
#ASR_DEBUG_AUDIO=0
#ASR_LOG_LEVEL=INFO

# ---- 解码 ----
# webm/ogg/m4a/aiff 需要 ffmpeg；PATH 里有就不用管
#FFMPEG_BIN=ffmpeg
