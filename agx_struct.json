      "agent_name": "Expo_App开发者",
      "agent_id": "expo_developer",
      "role": "worker",
      "model": null,
      "agent_labs": "expo_developer",
      "platform": "openclaw",
      "prompt": "",
      "description": "基于Expo框架的App开发者",
      "default_task": {
        "task_name": "通用消息处理",
        "task_labs": "general"
      },
      "scope": "system",
