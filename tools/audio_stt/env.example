# AgentGeeX · 语音转文字（tools/audio_stt）配置样例
#
# 来源：motozolo_gpt_tools/.env（2026-11-06 一并迁入）
# 说明：本目录的代码【直接读环境变量】，不自动加载 .env——
#       想让这些值生效，用 `set -a; . ./.env; set +a` 或 pm2/systemd 的 env 注入。
#       .env 本身被仓库 .gitignore 忽略（环境专属），故这里留一份样例供对照。
#
# 与本服务真正相关的只有下面「STT 相关」四行，其余是原项目的通用参数，
# 一并保留以免日后对照时对不上号。
#
# ── STT 相关（代码直接读）──────────────────────────────────────────────
# VOICE_MODEL=~/.cache/modelscope/hub/models/iic/SenseVoiceSmall
# VAD_MODEL=~/.cache/modelscope/hub/models/iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
# FFMPEG_BIN=ffmpeg           # 解任意容器音频用；不在 PATH 时给绝对路径
# ASR_HOST=127.0.0.1          # WS 服务绑定地址（对外监听才改 0.0.0.0）
# ASR_PORT=8888               # WS 服务端口
# ASR_DEBUG_AUDIO=0           # 1 = 每次识别存一份 wav（会积体积，默认关）
#
# ── 原项目通用参数（原样保留）─────────────────────────────────────────
# ----------------------------------------------------
# 路径配置（使用相对路径 .，自动适配任意新目录/新机器）
# ----------------------------------------------------
PYTHONPATH=.
APP_ROOT_DIR=.
FLASK_APP=app.py
# 如果 MODEL_DIR 在项目目录内部，推荐写成相对路径（例如 ./models 或 ../models）
# 如果在外部固定的位置，写绝对路径：
MODEL_DIR=D:\motogpt\project\poolguarder\train_sample\train_data
# ----------------------------------------------------
# 业务运行环境变量
# ----------------------------------------------------
PYTHONUNBUFFERED=1
LOGGING_MODEL=aiagent_web
LOGGING_SHOW_LEVEL=INFO
RUN_MODEL=DEV
APP_RUN_MODEL=product
BACKGROUND_QUEUE=ai_agent_background_queue
# 数据库/环境切换变量
POOLGUARDER_DB=motozolo_product
TMEPINGDINGADF=motozolo_test
TMEPINGDINGADF_PRODUCT=motozolo_product
TMEPINGDINGADF_local=motozolo_local
RUN_MODEL_DEV=DEV
RUN_MODEL_TEST=TEST
